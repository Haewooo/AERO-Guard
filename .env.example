# AeroGuard configuration (copy to .env and edit)

# ── authentication ────────────────────────────────────────────────
# SECURITY: set a strong random key in any real deployment.
#   openssl rand -base64 32
AEROGUARD_API_KEY=change-me-to-a-long-random-value
# Name recorded in the audit trail for the single-key console.
AEROGUARD_OPERATOR_NAME=console
# Multi-operator deployments: one key per person, so the audit trail
# attributes actions to an operator instead of to a shared console.
# Takes precedence over AEROGUARD_API_KEY when set.
# AEROGUARD_API_KEYS=twr-1:KEY_ONE,gnd-2:KEY_TWO

# ── audit chain ───────────────────────────────────────────────────
# HMAC key for the tamper-evident chain. Leave empty and one is generated
# at AEROGUARD_AUDIT_KEY_PATH on first run; supply it from a secret store
# in production. Losing it makes the existing chain unverifiable.
# AEROGUARD_AUDIT_KEY=
# AEROGUARD_AUDIT_KEY_PATH=data/audit.key
# Append-only chain-head anchors. Put this on different storage from the
# database (ideally WORM or a remote mount) so a full database rewrite is
# still detectable.
# AEROGUARD_AUDIT_ANCHOR_PATH=data/audit-anchors.log

# ── network ───────────────────────────────────────────────────────
AEROGUARD_HOST=127.0.0.1
AEROGUARD_PORT=8000
# Docker only: host interface the published port binds to. Leave at
# loopback unless a TLS-terminating reverse proxy sits in front.
# AEROGUARD_BIND=127.0.0.1
# Reverse proxies (CIDR, comma separated) allowed to set X-Forwarded-For.
# Empty means the header is never trusted and the socket peer is used for
# rate-limit accounting.
# AEROGUARD_TRUSTED_PROXIES=10.0.0.0/8

# ── observability ─────────────────────────────────────────────────
# Structured JSON logs with a request id (also returned as X-Request-ID).
# Set false for the human-readable formatter at a terminal.
# AEROGUARD_JSON_LOGS=true
# Days of audit history to keep. Startup verification reads the whole
# table, so an unbounded log makes boot time track total history.
# 0 keeps everything.
# AEROGUARD_AUDIT_RETENTION_DAYS=90

# ── detection tuning ──────────────────────────────────────────────
# Consecutive classification windows an alerting marshalling signal must
# hold before it fires, and how many it must then be absent for before it
# can fire again. Raising confirmations suppresses more false positives at
# the cost of ~1.6s each. See backend/fusion/gating.py.
# AEROGUARD_SIGNAL_CONFIRMATIONS=2
# AEROGUARD_SIGNAL_RELEASE_WINDOWS=3
# Threads for CPU inference. Detected from the cgroup quota, capped at the
# measured plateau; override to reserve headroom for the request path.
# AEROGUARD_INFERENCE_THREADS=4

# ── limits ────────────────────────────────────────────────────────
# Docker resource ceilings. TTS latency tracks the CPU quota almost
# linearly: 2 CPU -> 1498 ms, 4 -> 591 ms, 8 -> 262 ms per callout.
# AEROGUARD_CPUS=8.0
# AEROGUARD_MEMORY=3g
AEROGUARD_DB_PATH=data/aeroguard.db
# Live pose streaming at ~14 fps costs ~1000 req/min per operator.
AEROGUARD_RATE_LIMIT_PER_MINUTE=2400
AEROGUARD_LOG_LEVEL=INFO
